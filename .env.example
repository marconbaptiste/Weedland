# Configuration front (Vite) — copier ce fichier en `.env` et renseigner vos valeurs.
# Sur Vercel : Project → Settings → Environment Variables (mêmes noms).

# Tableau de bord Supabase > Project Settings > API
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Notifications push (carte de fidélité) — clé PUBLIQUE VAPID (la clé privée
# reste dans les secrets des Edge Functions). Vide = bouton « Être prévenu » masqué.
VITE_VAPID_PUBLIC_KEY=

# Anti-robots Cloudflare Turnstile sur l'inscription (clé PUBLIQUE ; la clé
# secrète va dans Supabase → Authentication → Bot protection). Vide = pas de widget.
VITE_TURNSTILE_SITE_KEY=

# Bouton « Ajouter à Apple Wallet » sur la carte (Edge Function carte-wallet).
VITE_WALLET_ACTIF=false

# ---------------------------------------------------------------------------
# Secrets des EDGE FUNCTIONS (Supabase → Edge Functions → Secrets) — pour mémoire,
# ils ne vont JAMAIS dans ce fichier ni sur Vercel :
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY (posés par Supabase)
#   APP_PUBLIC_URL            URL publique de l'app (retours Stripe), ex. https://kanabiz.dev
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_TAX_AUTO (off|on)
#   VAPID_PUBLIC, VAPID_PRIVATE, VAPID_SUBJECT (mailto:…)  ← noms EXACTS lus par envoyer-push
#   ANTHROPIC_API_KEY, VEILLE_CRON_SECRET (bulletin News)
# Détails : SUPABASE_STRIPE.md, SUPABASE_VEILLE.md.
# ---------------------------------------------------------------------------
